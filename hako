#!/usr/bin/env bash
# hako - Run this Android project's development commands in Gradle's JDK 21 image.
# The host needs Docker, but not Java, Gradle, or an Android SDK.
#
# Usage:
#   ./hako bash scripts/setup-android-sdk.sh  # Install the Android SDK once.
#   ./hako gradle --version
#   ./hako gradle --no-daemon assembleDebug
#   ./hako gradle --no-daemon assembleRelease  # Requires release signing keys.
#
# Android SDK and Gradle caches live in the ignored .devhome directory.
# Android build tools use Linux amd64 binaries; HAKO_PLATFORM can be overridden.
# There is no development server or published port. Add service-specific host
# and container port settings here if this project gains a development service.
set -Eeuo pipefail

readonly DEFAULT_IMAGE='gradle:9.4.1-jdk21@sha256:2d34fc215310891039e1b2b7797632de8d59eab54496c134bc2da711ba651c50'
REPO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly REPO_ROOT
step_index=0

usage() {
    printf 'Usage: %s <command> [argument ...]\n' "${0##*/}" >&2
    printf 'Example: %s gradle --no-daemon assembleDebug\n' "${0##*/}" >&2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf '[hako] required command not found: %s\n' "$1" >&2
        return 127
    }
}

log_step() {
    local label=$1
    shift

    step_index=$((step_index + 1))
    printf '#%s [hako %s]' "$step_index" "$label" >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
}

run_step() {
    local label=$1
    shift

    log_step "$label" "$@"
    "$@"
}

main() {
    local image=${HAKO_IMAGE:-$DEFAULT_IMAGE}
    local platform=${HAKO_PLATFORM:-linux/amd64}
    local devhome=${REPO_ROOT}/.devhome
    local -a tty_flags=()
    local -a docker_cmd=()

    if [[ $# -eq 0 || ${1:-} == --help || ${1:-} == -h ]]; then
        usage
        [[ $# -gt 0 ]]
        return
    fi

    if [[ -n ${HAKO_SERVICE:-} ]]; then
        printf '[hako] no development service is configured: %s\n' "$HAKO_SERVICE" >&2
        return 2
    fi

    require_command docker
    require_command id
    require_command mkdir
    run_step internal mkdir -p -- "$devhome"

    if [[ -t 0 ]]; then
        tty_flags+=(-i)
        if [[ -t 1 ]]; then
            tty_flags+=(-t)
        fi
    fi

    docker_cmd=(
        docker run --rm
        "${tty_flags[@]}"
        --platform "$platform"
        --user "$(id -u):$(id -g)"
        --env HOME=/app/.devhome
        --env GRADLE_USER_HOME=/app/.devhome/gradle
        --env ANDROID_HOME=/app/.devhome/android-sdk
        --env ANDROID_SDK_ROOT=/app/.devhome/android-sdk
        --volume "${REPO_ROOT}:/app"
        --workdir /app
        --label "hako.repo=${REPO_ROOT}"
        --label "hako.scope=${HAKO_SCOPE:-manual}"
        --label "hako.service=${HAKO_SERVICE:-}"
        "$image" "$@"
    )

    log_step run "${docker_cmd[@]}"
    exec "${docker_cmd[@]}"
}

main "$@"
